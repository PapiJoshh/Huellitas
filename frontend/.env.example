# URL de la API de pagos (Render)
VITE_API_URL=https://tu-api.onrender.com

# Supabase (Project Settings > API). La anon key es pública por diseño; la protege RLS.
# Si se dejan vacías, la app funciona en modo local (datos en el navegador, sin login).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key
